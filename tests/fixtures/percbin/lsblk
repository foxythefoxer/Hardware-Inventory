#!/bin/bash
# The Unraid-shaped disk layout C-016 is about: the first non-NVMe disk is the
# USB boot key, not a disk that routes through the RAID controller. Targeting
# it makes `-d megaraid,N` answer for nothing on a host whose array is fine.
#
# nvme0n1 comes first on purpose — it is excluded by both name and TRAN, so a
# probe that only skips `nvme*` still lands on the boot key, which is exactly
# what it used to do. zd0 is a ZFS zvol: TYPE="disk", excluded by name (C-012).
#
# Serials are invented, and named as such. One lsblk answer serves every call
# site since A-007 hoisted them into a single -P capture.
#
# sda's MODEL carries the literal pipes C-004 is about: unescaped they split
# the row into extra columns and shift every cell after it.
cat <<'L'
NAME="nvme0n1" TYPE="disk" SIZE="1.8T" ROTA="0" TRAN="nvme" MODEL="FIXTURE-NVME" SERIAL="FIXTURE-NVME-0001"
NAME="sda" TYPE="disk" SIZE="14.6G" ROTA="1" TRAN="usb" MODEL="FIXTURE|BOOT|KEY" SERIAL="FIXTURE-USB-0001"
NAME="sdb" TYPE="disk" SIZE="3.6T" ROTA="1" TRAN="sata" MODEL="FIXTURE-DISK-A" SERIAL="FIXTURE-SATA-0001"
NAME="zd0" TYPE="disk" SIZE="32G" ROTA="1" TRAN="" MODEL="" SERIAL=""
NAME="loop0" TYPE="loop" SIZE="4G" ROTA="1" TRAN="" MODEL="" SERIAL=""
L
