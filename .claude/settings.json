{
  "enabledPlugins": {
    "ponytail@ponytail": true,
    "hookify@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(bash tests/run.sh)",
      "Bash(bash tests/run.sh *)",
      "Bash(git -C * log *)",
      "Bash(git -C * status *)",
      "Bash(git -C * rev-list *)",
      "Bash(git -C * diff *)",
      "Bash(git -C * show *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/no-write-verbs.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/no-estate-identity.sh --hook"
          }
        ]
      }
    ]
  }
}
